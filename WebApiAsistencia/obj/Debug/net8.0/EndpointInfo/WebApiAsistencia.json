{
  "openapi": "3.0.1",
  "info": {
    "title": "WebApiAsistencia",
    "version": "1.0"
  },
  "paths": {
    "/api/Asistencia/Marcar": {
      "post": {
        "tags": [
          "Asistencia"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "Foto",
                  "Latitud",
                  "Longitud"
                ],
                "type": "object",
                "properties": {
                  "Latitud": {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number",
                    "format": "double"
                  },
                  "Longitud": {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number",
                    "format": "double"
                  },
                  "Foto": {
                    "type": "string",
                    "format": "binary"
                  },
                  "IdSucursal": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "IdTipoMarcacion": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              },
              "encoding": {
                "Latitud": {
                  "style": "form"
                },
                "Longitud": {
                  "style": "form"
                },
                "Foto": {
                  "style": "form"
                },
                "IdSucursal": {
                  "style": "form"
                },
                "IdTipoMarcacion": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Asistencia/HistorialAsistencia": {
      "get": {
        "tags": [
          "Asistencia"
        ],
        "parameters": [
          {
            "name": "fecha",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/Login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/Registrar": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioRegistroDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioRegistroDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioRegistroDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Sucursal/Sucursales": {
      "get": {
        "tags": [
          "Sucursal"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Sucursal/Registrar": {
      "post": {
        "tags": [
          "Sucursal"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SucursalRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SucursalRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SucursalRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/TipoMarcacion/TiposMarcacion": {
      "get": {
        "tags": [
          "TipoMarcacion"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "documentoIdentidad": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SucursalRequestDto": {
        "required": [
          "latitud",
          "longitud",
          "nombre"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "latitud": {
            "type": "number",
            "format": "double"
          },
          "longitud": {
            "type": "number",
            "format": "double"
          },
          "radioPermitidoMetros": {
            "maximum": 1000,
            "minimum": 10,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UsuarioRegistroDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "nullable": true
          },
          "apellido": {
            "type": "string",
            "nullable": true
          },
          "documentoIdentidad": {
            "type": "string",
            "nullable": true
          },
          "idSucursal": {
            "type": "integer",
            "format": "int32"
          },
          "idHorario": {
            "type": "integer",
            "format": "int32"
          },
          "idRol": {
            "type": "integer",
            "format": "int32"
          },
          "passwordClara": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Escribe la palabra 'Bearer' seguida de un espacio y tu token JWT.\n\nEjemplo: \"Bearer eyJhbGciOiJIUzI1Ni...\"",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}